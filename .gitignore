# Data artifacts are never committed: they are large, and the lyrics cache is copyrighted.
data/
!data/.gitkeep

# Lyrics cache (copyrighted text) — belt and braces, in case it moves.
**/lyrics_cache/
**/*.lyrics.txt

.env
.venv/
venv/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Figures ARE committed: the README embeds them, so they must render on GitHub.
# They are derived artefacts, but small (~200-400 KB each) and regenerating them
# requires the full pipeline, which a reader of the README will not have run.

.DS_Store

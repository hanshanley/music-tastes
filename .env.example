# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Genius API access token (free): https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Contact string sent in the User-Agent to MusicBrainz / AcousticBrainz, as their
# rate-limiting policy requires. Use a real email or project URL.
MUSICBRAINZ_CONTACT=

# Hosted LLM for the Method B theme classifier.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: BPM fallback source. https://getsongbpm.com/api
GETSONGBPM_API_KEY=
